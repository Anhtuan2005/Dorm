@model StudentRoomSearchViewModel
@{
    Layout = "_StudentLayout";
    string Money(decimal value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
    var hasFilters = Model.Query.Building is not null || Model.Query.MaxPrice is not null ||
        Model.Query.Amenity is not null || Model.Query.Sort != "availability";
}

<div class="room-search-page">
<header class="student-page-head room-search-head">
    <div><h1>Tìm phòng</h1><p>Khám phá phòng còn chỗ phù hợp với hồ sơ và chọn giường trên mô hình 3D.</p></div>
    @if (Model.CurrentRoomCode is string roomCode)
    {
        <a class="room-current-link" asp-action="Dashboard" asp-fragment="roommates">
            <span class="room-current-icon"><svg aria-hidden="true"><use href="#s-bed" /></svg></span>
            <span><small>Phòng hiện tại</small><strong>@roomCode</strong></span>
            <span class="room-current-action">Xem bạn cùng phòng <svg aria-hidden="true"><use href="#s-arrow" /></svg></span>
        </a>
    }
</header>

@if (Model.ActiveRequest is not null)
{
    <section class="active-request-banner"><span><svg><use href="#s-clock" /></svg></span><div><small>Bạn đang có đơn chờ xử lý</small><strong>@Model.ActiveRequest.Code · @Model.ActiveRequest.TargetRoomCode</strong></div><span class="request-status @Model.ActiveRequest.StatusClass">@Model.ActiveRequest.StatusLabel</span><a asp-action="Applications">Theo dõi đơn <svg><use href="#s-arrow" /></svg></a></section>
}

<form class="student-room-filters" method="get" asp-action="Rooms">
    <label><span>Tòa nhà</span><select name="Building"><option value="">Tất cả tòa phù hợp</option>@foreach (var building in Model.Buildings) { <option value="@building" selected="@(Model.Query.Building == building)">Tòa @building</option> }</select></label>
    <label><span>Khoảng giá</span><select name="MaxPrice"><option value="">Tất cả mức giá</option><option value="1250000" selected="@(Model.Query.MaxPrice == 1250000)">Đến 1.250.000 đ</option><option value="1350000" selected="@(Model.Query.MaxPrice == 1350000)">Đến 1.350.000 đ</option></select></label>
    <label><span>Tiện nghi</span><select name="Amenity"><option value="">Bất kỳ</option>@foreach (var amenity in Model.Amenities) { <option value="@amenity" selected="@(Model.Query.Amenity == amenity)">@amenity</option> }</select></label>
    <label><span>Sắp xếp</span><select name="Sort"><option value="availability" selected="@(Model.Query.Sort == "availability")">Nhiều chỗ trước</option><option value="price" selected="@(Model.Query.Sort == "price")">Giá thấp trước</option><option value="building" selected="@(Model.Query.Sort == "building")">Theo tòa</option></select></label>
    <button type="submit"><svg><use href="#s-search" /></svg>Tìm phòng</button>
</form>

<div class="student-results-head">
    <div class="room-result-count"><h2>Phòng còn chỗ</h2><span>@Model.TotalMatches phòng</span></div>
    @if (hasFilters)
    {
        <a class="filter-reset" asp-action="Rooms"><svg aria-hidden="true"><use href="#s-close" /></svg>Xóa bộ lọc</a>
    }
</div>

@if (Model.Rooms.Count == 0)
{
    <section class="student-empty"><span><svg><use href="#s-search" /></svg></span><h2>Không tìm thấy phòng phù hợp</h2>
        @if (hasFilters)
        {
            <p>Thử thay đổi hoặc xóa bộ lọc để xem thêm lựa chọn.</p><a asp-action="Rooms">Xóa bộ lọc</a>
        }
        else
        {
            <p>Hiện chưa có phòng phù hợp với hồ sơ còn chỗ có thể xếp.</p>
        }
    </section>
}
else
{
    <div class="student-room-list">
        @foreach (var room in Model.Rooms)
        {
            var unavailableBeds = Math.Max(0, room.Capacity - room.Occupied - room.Assignable);
            <article class="student-room-card">
                @if (room.Photos.FirstOrDefault() is { } cover)
                {
                    <img class="room-choice-photo" src="@Url.Action("RoomPhoto", "Attachments", new { id = cover.Id })"
                         alt="@(string.IsNullOrWhiteSpace(cover.Caption) ? $"Ảnh phòng {room.Code}" : cover.Caption)"
                         loading="lazy" decoding="async" />
                }
                else
                {
                    var photo = RoomIllustration.ForRoom(room.Id, room.Amenities)[0];
                    <figure class="room-illustration-cover">
                        <img src="~/images/rooms/@(photo.File).webp" alt="@photo.Caption" loading="lazy" decoding="async" width="764" height="508" />
                        <figcaption>Ảnh minh họa AI</figcaption>
                    </figure>
                }
                <header class="room-choice-header">
                    <div>
                        <p>@room.BuildingName · Tầng @room.FloorNumber · @room.RoomType</p>
                        <h3>Phòng @room.Code</h3>
                    </div>
                    <div class="room-choice-price"><strong>@Money(room.MonthlyPrice) đ</strong><small>/ tháng</small></div>
                </header>
                <div class="room-choice-facts">
                    <div class="room-capacity-panel">
                        <p><strong class="room-choice-available">@room.Assignable chỗ có thể xếp</strong><span>@room.Occupied/@room.Capacity đang ở</span></p>
                        <div class="room-capacity-track" aria-hidden="true">
                            @if (room.Capacity <= 12)
                            {
                                @for (var slot = 0; slot < room.Capacity; slot++)
                                {
                                    var state = slot < room.Occupied ? "occupied" : slot < room.Occupied + unavailableBeds ? "unavailable" : "available";
                                    <span class="room-capacity-@state"></span>
                                }
                            }
                            else
                            {
                                @if (room.Occupied > 0) { <span class="room-capacity-occupied" style="flex-grow: @room.Occupied"></span> }
                                @if (unavailableBeds > 0) { <span class="room-capacity-unavailable" style="flex-grow: @unavailableBeds"></span> }
                                <span class="room-capacity-available" style="flex-grow: @room.Assignable"></span>
                            }
                        </div>
                        @if (unavailableBeds > 0)
                        {
                            <small class="room-capacity-held">@unavailableBeds chỗ đang giữ hoặc tạm khóa</small>
                        }
                    </div>
                    @if (room.Amenities.Count > 0)
                    {
                        <ul class="room-choice-amenities" aria-label="Tiện nghi">
                            @foreach (var amenity in room.Amenities.Take(4)) { <li><svg aria-hidden="true"><use href="#s-check" /></svg>@amenity</li> }
                            @if (room.Amenities.Count > 4) { <li class="room-amenities-more">+@(room.Amenities.Count - 4) tiện nghi</li> }
                        </ul>
                    }
                </div>
                <footer class="room-choice-footer">
                    <a class="student-secondary room-preview-link" asp-action="RoomPreview" asp-route-id="@room.Id" data-apply-room data-room-code="@room.Code">
                        <svg aria-hidden="true"><use href="#s-bed" /></svg>
                        <span>@(Model.ActiveRequest is null ? "Chọn phòng" : "Xem phòng")</span>
                        <svg aria-hidden="true"><use href="#s-arrow" /></svg>
                    </a>
                </footer>
            </article>
        }
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav class="student-pagination" aria-label="Phân trang phòng">
        @if (Model.Query.Page > 1)
        {
            <a class="student-secondary" asp-action="Rooms" asp-route-Building="@Model.Query.Building" asp-route-MaxPrice="@Model.Query.MaxPrice" asp-route-Amenity="@Model.Query.Amenity" asp-route-Sort="@Model.Query.Sort" asp-route-Page="@(Model.Query.Page - 1)">Trang trước</a>
        }
        <span>Trang @Model.Query.Page / @Model.TotalPages</span>
        @if (Model.Query.Page < Model.TotalPages)
        {
            <a class="student-secondary" asp-action="Rooms" asp-route-Building="@Model.Query.Building" asp-route-MaxPrice="@Model.Query.MaxPrice" asp-route-Amenity="@Model.Query.Amenity" asp-route-Sort="@Model.Query.Sort" asp-route-Page="@(Model.Query.Page + 1)">Trang sau</a>
        }
    </nav>
}
</div>
