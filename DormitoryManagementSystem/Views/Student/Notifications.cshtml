@model StudentNotificationsViewModel
@{ Layout = "_StudentLayout"; }

<section class="student-page-head">
    <div><p class="student-kicker">Cập nhật dành cho bạn</p><h1>Thông báo</h1><p>Theo dõi thay đổi của đơn lưu trú, hóa đơn và yêu cầu sửa chữa.</p></div>
    <form asp-action="MarkAllNotificationsRead" method="post" data-live-mark-all hidden="@(Model.UnreadCount == 0)">
        <input type="hidden" name="page" value="@Model.Page" />
        <button class="student-secondary page-action" type="submit"><svg><use href="#s-check" /></svg>Đánh dấu tất cả đã đọc</button>
    </form>
</section>

<partial name="_NotificationInbox" model="Model" />
