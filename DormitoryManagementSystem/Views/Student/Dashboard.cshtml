@model StudentDashboardViewModel
@inject TimeProvider Clock
@{
    Layout = "_StudentLayout";
    string Money(decimal value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
    string Date(DateOnly value) => value.ToString("dd/MM/yyyy");
    var today = TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time"));
}

<section class="student-page-head dashboard-head">
    <div><h1>Chào @Model.Student.FullName.Split(' ').Last()</h1><p>@(Model.CurrentStay is null ? "Tìm phòng để bắt đầu đăng ký ở KTX." : $"Thông tin phòng {Model.CurrentStay.RoomCode} và các yêu cầu của bạn.")</p></div>
    <span class="student-date">@today.ToString("dddd, dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span>
</section>

@if (Model.NextInvoice is not null)
{
    <section class="student-focus-card">
        <span class="focus-icon"><svg><use href="#s-wallet" /></svg></span>
        <div class="focus-copy"><span class="focus-deadline @(Model.NextInvoice.DueDate < DateOnly.FromDateTime(today.DateTime) ? "overdue" : "")">@(Model.NextInvoice.DueDate < DateOnly.FromDateTime(today.DateTime) ? "Quá hạn thanh toán" : "Hạn thanh toán") @Date(Model.NextInvoice.DueDate)</span><h2>Hóa đơn @Model.NextInvoice.PeriodName.ToLowerInvariant()</h2><p>@Model.NextInvoice.Code</p></div>
        <div class="focus-amount"><small>Cần thanh toán</small><strong>@Money(Model.NextInvoice.Balance) đ</strong></div>
        <a asp-action="Invoices">Xem hóa đơn <svg><use href="#s-arrow" /></svg></a>
    </section>
}

<div class="student-dashboard-grid">
    <div class="student-dashboard-primary">
        <section class="student-section">
            <header class="student-section-head"><div><h2>Phòng hiện tại</h2></div>@if (Model.CurrentStay is not null) { <span class="live-status">Đang lưu trú</span> }</header>
            @if (Model.CurrentStay is not null)
            {
                <article class="room-pass">
                    <div class="room-pass-code"><small>@Model.CurrentStay.BuildingName · Tầng @Model.CurrentStay.FloorNumber</small><strong>@Model.CurrentStay.RoomCode</strong><span>Phòng @Model.CurrentStay.Capacity người</span></div>
                    <dl><div><dt>Giá phòng</dt><dd>@Money(Model.CurrentStay.MonthlyPrice) đ<small>/tháng</small></dd></div><div><dt>Nhận phòng</dt><dd>@Model.CurrentStay.StartedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>@if (Model.CurrentStay.BedNumber is int bed) { <div><dt>Giường</dt><dd>@bed.ToString("00")</dd></div> }</dl>
                    <div class="room-pass-amenities">@foreach (var amenity in Model.CurrentStay.Amenities.Take(4)) { <span>@amenity</span> }</div>
                    <span class="room-pass-mark"><svg><use href="#s-bed" /></svg></span>
                </article>
                <div class="student-roommates" id="roommates">
                    <h3>Bạn cùng phòng</h3>
                    @if (Model.CurrentStay.RoommateNames.Count > 0)
                    {
                        <ul class="student-roommate-list">
                            @foreach (var name in Model.CurrentStay.RoommateNames)
                            {
                                <li>@name</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Hiện bạn chưa có bạn cùng phòng.</p>
                    }
                </div>
            }
            else
            {
                <div class="no-current-stay"><span><svg><use href="#s-bed" /></svg></span><div><strong>Chưa có phòng hiện tại</strong><p>Tìm phòng phù hợp để gửi đơn đăng ký ở.</p></div><a asp-action="Rooms">Tìm phòng</a></div>
            }
        </section>

        <section class="student-section">
            <header class="student-section-head"><div><p>Tiến độ gần đây</p><h2>Việc của bạn</h2></div><a asp-action="Applications">Xem tất cả</a></header>
            <div class="student-activity-list">
                @if (Model.ActiveRequest is not null)
                {
                    <a asp-action="Applications" class="student-activity"><span class="activity-icon teal"><svg><use href="#s-file" /></svg></span><span><strong>@Model.ActiveRequest.TypeLabel@(Model.ActiveRequest.TargetRoomCode is null ? "" : $" · {Model.ActiveRequest.TargetRoomCode}")</strong><small>@Model.ActiveRequest.Code · @Model.ActiveRequest.NextActionLabel</small></span><span class="activity-status @Model.ActiveRequest.StatusClass">@Model.ActiveRequest.StatusLabel</span><svg><use href="#s-chevron" /></svg></a>
                }
                else
                {
                    <a asp-action="Rooms" class="student-activity"><span class="activity-icon teal"><svg><use href="#s-search" /></svg></span><span><strong>@(Model.CurrentStay is null ? "Đăng ký ở KTX" : "Chuyển phòng")</strong><small>Tìm phòng phù hợp với hồ sơ</small></span><svg><use href="#s-chevron" /></svg></a>
                }
                @if (Model.ActiveRepair is not null)
                {
                    <a asp-action="Repairs" class="student-activity"><span class="activity-icon orange"><svg><use href="#s-tool" /></svg></span><span><strong>@Model.ActiveRepair.Title</strong><small>@Model.ActiveRepair.Code · Cập nhật @Model.ActiveRepair.UpdatedAt.ToLocalTime().ToString("dd/MM, HH:mm")</small></span><span class="activity-status @Model.ActiveRepair.StatusClass">@Model.ActiveRepair.StatusLabel</span><svg><use href="#s-chevron" /></svg></a>
                }
            </div>
        </section>
    </div>

    <aside class="student-dashboard-aside">
        <section class="student-section quick-actions">
            <header class="student-section-head"><div><h2>Thao tác</h2></div></header>
            <div><a asp-action="Rooms"><span><svg><use href="#s-search" /></svg></span><strong>Tìm phòng</strong><small>@(Model.CurrentStay is null ? "Đăng ký ở KTX" : "Đăng ký chuyển phòng")</small></a>@if (Model.CurrentStay is not null) { <a asp-action="Repairs" asp-fragment="new-request"><span><svg><use href="#s-tool" /></svg></span><strong>Báo sự cố</strong><small>Gửi yêu cầu sửa chữa trong phòng</small></a> }</div>
        </section>

        <partial name="_RecentNotifications" model="Model.Notifications" />
    </aside>
</div>
