@model StudentRepairsViewModel
@{
    Layout = "_StudentLayout";
}

<section class="student-page-head"><div><p class="student-kicker">Phòng @Model.CurrentRoomCode</p><h1>Yêu cầu hỗ trợ</h1><p>Báo sự cố trong phòng và theo dõi từng cập nhật từ ban quản lý.</p></div><button class="student-primary page-action" type="button" data-repair-open id="new-request"><svg><use href="#s-plus" /></svg>Gửi yêu cầu</button></section>

<section class="repair-guidance"><span><svg><use href="#s-help" /></svg></span><div><strong>Nếu có nguy hiểm tức thời</strong><p>Ngắt nguồn điện/nước nếu an toàn và gọi trực ban <a href="tel:02838965501">028 3896 5501</a>. Không chờ phản hồi trên hệ thống.</p></div></section>

@if (Model.Repairs.Count == 0)
{
    <section class="student-empty"><span><svg><use href="#s-tool" /></svg></span><h2>Chưa có yêu cầu sửa chữa</h2><p>Khi phát hiện hư hỏng, hãy mô tả rõ vị trí và mức độ ảnh hưởng.</p><button type="button" data-repair-open>Gửi yêu cầu đầu tiên</button></section>
}
else
{
    <div class="repair-list">
        @foreach (var repair in Model.Repairs)
        {
            <article class="repair-card">
                <header><div><span class="repair-status @repair.StatusClass">@repair.StatusLabel</span><h2>@repair.Title</h2><p>@repair.Code · Phòng @repair.RoomCode · @repair.Category</p></div><div class="repair-meta"><small>Mức độ</small><strong>@repair.PriorityLabel</strong><small>Cập nhật @repair.UpdatedAt.ToLocalTime().ToString("dd/MM, HH:mm")</small></div></header>
                <p class="repair-description">@repair.Description</p>
                <div class="repair-timeline">
                    @foreach (var update in repair.Updates)
                    {
                        <div><i><svg><use href="#s-check" /></svg></i><span><strong>@update.StatusLabel</strong><small>@update.Note</small></span><time>@update.CreatedAt.ToLocalTime().ToString("dd/MM, HH:mm")</time></div>
                    }
                </div>
            </article>
        }
    </div>
}

<dialog class="student-dialog repair-dialog" data-repair-dialog aria-labelledby="repair-title">
    <form method="post" asp-action="CreateRepair">
        <header><div><p>Phòng @Model.CurrentRoomCode</p><h2 id="repair-title">Mô tả sự cố cần hỗ trợ</h2></div><button type="button" data-dialog-close aria-label="Đóng"><svg><use href="#s-close" /></svg></button></header>
        <div class="form-grid">
            <label class="student-form-field"><span>Nhóm sự cố</span><select name="Category" required><option value="">Chọn nhóm</option><option>Điện nước</option><option>Thiết bị phòng</option><option>Internet</option><option>Vệ sinh</option><option>An ninh</option><option>Khác</option></select></label>
            <label class="student-form-field"><span>Mức độ ảnh hưởng</span><select name="Priority" required><option value="Low">Ảnh hưởng nhẹ</option><option value="Medium" selected>Ảnh hưởng vừa</option><option value="High">Ảnh hưởng lớn</option><option value="Urgent">Khẩn cấp</option></select></label>
        </div>
        <label class="student-form-field"><span>Tiêu đề</span><input name="Title" minlength="5" maxlength="180" required placeholder="Ví dụ: Đèn trần không hoạt động" /></label>
        <label class="student-form-field"><span>Mô tả chi tiết</span><textarea name="Description" rows="5" minlength="15" maxlength="1000" required placeholder="Vị trí, thời điểm phát hiện và mức độ ảnh hưởng..."></textarea><small>Không gửi thông tin nhạy cảm hoặc ảnh giấy tờ cá nhân.</small></label>
        <footer><button type="button" class="student-secondary" data-dialog-close>Hủy</button><button type="submit" class="student-primary">Gửi yêu cầu</button></footer>
    </form>
</dialog>
