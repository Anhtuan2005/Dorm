@model StudentApplicationsViewModel
@{
    Layout = "_StudentLayout";
    string WaitLabel(int hours) => hours < 24 ? $"{hours} giờ" : $"{hours / 24} ngày {hours % 24} giờ";
}

<section class="student-page-head application-student-head">
    <div><p class="student-kicker">Hồ sơ lưu trú</p><h1>Đăng ký của tôi</h1><p>Theo dõi lượt xử lý, bổ sung hồ sơ và xem đầy đủ dấu vết quyết định.</p></div>
    <div class="student-page-actions">
        @if (!Model.HasActiveRequest)
        {
            <a class="student-primary page-action" asp-action="Rooms"><svg><use href="#s-plus" /></svg>@(Model.CurrentRoomCode is null ? "Đăng ký phòng" : "Chuyển phòng")</a>
            @if (Model.CanSubmitCheckout)
            {
                <button type="button" class="student-secondary page-action" data-open-dialog="checkout-dialog"><svg><use href="#s-file" /></svg>Trả phòng</button>
            }
        }
    </div>
</section>

@if (Model.Requests.Count == 0)
{
    <section class="student-empty"><span><svg><use href="#s-file" /></svg></span><h2>Bạn chưa có đơn nào</h2><p>Tìm phòng còn chỗ để bắt đầu yêu cầu đăng ký hoặc chuyển phòng.</p><a asp-action="Rooms">Tìm phòng phù hợp</a></section>
}
else
{
    <div class="application-list">
        @foreach (var request in Model.Requests)
        {
            <article class="application-card @(request.CanCancel ? "current" : "") @(request.CanSupplement ? "needs-student-action" : "")">
                <header>
                    <div><span class="request-status @request.StatusClass">@request.StatusLabel</span><h2>@request.TypeLabel@(request.TargetRoomCode is null ? "" : $" · Phòng {request.TargetRoomCode}")</h2><p>@request.Code · Gửi lúc @request.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy, HH:mm")</p></div>
                    @if (request.CanCancel)
                    {
                        <form asp-action="CancelHousingRequest" method="post" data-confirm="Bạn chắc chắn muốn hủy đơn @request.Code?"><input type="hidden" name="Id" value="@request.Id" /><input type="hidden" name="RowVersion" value="@request.RowVersion" /><button type="submit" class="student-danger-text">Hủy đơn</button></form>
                    }
                </header>

                <section class="student-request-handoff @request.StatusClass">
                    <span><small>Lượt xử lý hiện tại</small><strong>@request.ResponsibilityLabel</strong></span>
                    <i><svg><use href="@(request.CanSupplement ? "#s-file" : "#s-clock")" /></svg></i>
                    <span><small>Việc tiếp theo</small><strong>@request.NextActionLabel</strong><em>Đã chờ @WaitLabel(request.WaitingHours)</em></span>
                </section>

                @if (request.CanSupplement)
                {
                    <form class="student-supplement-form" asp-action="SupplementHousingRequest" method="post">
                        <input type="hidden" name="Id" value="@request.Id" /><input type="hidden" name="RowVersion" value="@request.RowVersion" />
                        <div><p>Ban quản lý yêu cầu bổ sung</p><strong>@(request.DecisionReason ?? "Vui lòng bổ sung thông tin còn thiếu.")</strong></div>
                        <label><span>Nội dung bổ sung</span><textarea name="Information" minlength="10" maxlength="600" rows="4" required placeholder="Trả lời cụ thể nội dung Ban quản lý đang cần..."></textarea><small>Từ 10 đến 600 ký tự</small></label>
                        <button type="submit" class="student-primary">Gửi bổ sung và chuyển lại BQL</button>
                    </form>
                }

                <details open="@request.CanSupplement">
                    <summary>Thông tin và nhật ký đơn</summary>
                    <dl><div><dt>Loại yêu cầu</dt><dd>@request.TypeLabel</dd></div><div><dt>Phòng mong muốn</dt><dd>@(request.TargetRoomCode ?? "Không áp dụng")</dd></div><div><dt>Lý do</dt><dd>@request.StudentReason</dd></div></dl>
                    <div class="student-request-events">
                        @if (request.Events.Count == 0)
                        {
                            <p>Chưa có cập nhật trong nhật ký.</p>
                        }
                        else
                        {
                            @foreach (var entry in request.Events)
                            {
                                <article><i class="@entry.StatusClass"><svg><use href="#s-check" /></svg></i><span><strong>@entry.StatusLabel</strong><p>@entry.Note</p><small>@entry.ActorName · @entry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy, HH:mm")</small></span></article>
                            }
                        }
                    </div>
                </details>
            </article>
        }
    </div>
}

@if (Model.CanSubmitCheckout)
{
    <dialog class="student-dialog" id="checkout-dialog" aria-labelledby="checkout-title">
        <form method="post" asp-action="SubmitCheckoutRequest">
            <header><div><p>Kết thúc lượt lưu trú</p><h2 id="checkout-title">Yêu cầu trả phòng @Model.CurrentRoomCode</h2></div><button type="button" data-dialog-close aria-label="Đóng"><svg><use href="#s-close" /></svg></button></header>
            <div class="dialog-note"><svg><use href="#s-file" /></svg><p>Gửi yêu cầu không kết thúc lượt lưu trú ngay. Bạn vẫn thuộc phòng @Model.CurrentRoomCode cho đến khi Ban quản lý duyệt.</p></div>
            <label class="student-form-field"><span>Lý do trả phòng</span><textarea name="Reason" rows="5" minlength="10" maxlength="600" required placeholder="Ví dụ: Kết thúc học kỳ và bàn giao phòng ngày..."></textarea><small>Từ 10 đến 600 ký tự</small></label>
            <footer><button type="button" class="student-secondary" data-dialog-close>Quay lại</button><button type="submit" class="student-primary">Gửi yêu cầu trả phòng</button></footer>
        </form>
    </dialog>
}
