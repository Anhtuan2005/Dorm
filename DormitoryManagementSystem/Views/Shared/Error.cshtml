@model ErrorViewModel
@{
    Layout = "_InfoLayout";
    ViewData["Title"] = "Chưa thể hoàn tất yêu cầu";
}

<div class="status-page">
    <h1>Chưa thể hoàn tất yêu cầu</h1>
    <p>Quay lại để kiểm tra kết quả trước khi thử lại. Nếu lỗi lặp lại, hãy gửi mã tra cứu cho Ban quản lý.</p>
    @if (Model.ShowRequestId)
    {
        <p class="info-trace">Mã tra cứu <code>@Model.RequestId</code></p>
    }
    <a class="info-primary" asp-controller="Home" asp-action="Index">Về trang của tôi</a>
</div>
