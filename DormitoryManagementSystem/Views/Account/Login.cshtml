@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập · NẾP KTX</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-shell">
        <div class="auth-intro">
            <span class="brand-name">NẾP KTX</span>
            <p>Cơ sở Thủ Đức</p>
        </div>
        <section class="auth-panel">
            <h1>Đăng nhập</h1>
            <p>Dùng tài khoản do Ban quản lý cung cấp.</p>
            <form class="auth-form" asp-action="Login" method="post">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" role="alert" tabindex="-1"></div>
                <div class="auth-field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" autocomplete="username" required aria-describedby="login-email-error" />
                    <span id="login-email-error" asp-validation-for="Email"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="Password">Mật khẩu</label>
                    <div class="password-field">
                        <input asp-for="Password" autocomplete="current-password" required aria-describedby="login-password-error" />
                        <button type="button" data-password-toggle aria-label="Hiện mật khẩu" aria-controls="Password">Hiện</button>
                    </div>
                    <span id="login-password-error" asp-validation-for="Password"></span>
                </div>
                <label class="auth-check"><input asp-for="RememberMe" /> Duy trì đăng nhập trên thiết bị này</label>
                <button class="auth-submit" type="submit">Đăng nhập</button>
            </form>
            <p class="account-data-link"><a asp-controller="Home" asp-action="Privacy">Thông tin dữ liệu và hỗ trợ</a></p>
        </section>
    </main>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
</body>
</html>
