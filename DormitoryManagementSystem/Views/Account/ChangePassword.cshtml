@model ChangePasswordViewModel
@using DormitoryManagementSystem.Security
@{ Layout = User.IsInRole(RoleNames.Student) ? "_StudentLayout" : "_Layout"; }

<div class="password-page">
    <header class="operations-heading"><div><h1>Đổi mật khẩu</h1><p>Mật khẩu mới cần ít nhất 8 ký tự, có chữ hoa, chữ thường và số.</p></div></header>
    <section class="password-panel" aria-label="Biểu mẫu đổi mật khẩu">
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="form-error-summary" role="alert" tabindex="-1"></div>
            <div class="password-row">
                <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                <div class="password-field">
                    <input asp-for="CurrentPassword" autocomplete="current-password" required aria-describedby="current-password-error" />
                    <button type="button" data-password-toggle data-password-label="mật khẩu hiện tại" aria-label="Hiện mật khẩu hiện tại" aria-controls="CurrentPassword">Hiện</button>
                </div>
                <small id="current-password-error" asp-validation-for="CurrentPassword"></small>
            </div>
            <div class="password-row">
                <label asp-for="NewPassword">Mật khẩu mới</label>
                <div class="password-field">
                    <input asp-for="NewPassword" autocomplete="new-password" minlength="8" maxlength="100" required data-new-password aria-describedby="new-password-error" />
                    <button type="button" data-password-toggle data-password-label="mật khẩu mới" aria-label="Hiện mật khẩu mới" aria-controls="NewPassword">Hiện</button>
                </div>
                <small id="new-password-error" asp-validation-for="NewPassword"></small>
            </div>
            <div class="password-row">
                <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" autocomplete="new-password" required data-confirm-password aria-describedby="confirm-password-error password-match" />
                    <button type="button" data-password-toggle data-password-label="mật khẩu nhập lại" aria-label="Hiện mật khẩu nhập lại" aria-controls="ConfirmPassword">Hiện</button>
                </div>
                <small id="confirm-password-error" asp-validation-for="ConfirmPassword"></small>
                <small class="password-match-status" id="password-match" data-password-match aria-live="polite"></small>
            </div>
            <button type="submit">Đổi mật khẩu</button>
        </form>
    </section>
    <p class="account-data-link"><a asp-controller="Home" asp-action="Privacy">Thông tin dữ liệu và hỗ trợ</a></p>
</div>
