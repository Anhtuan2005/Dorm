@model ChangePasswordViewModel
@using DormitoryManagementSystem.Security
@{ Layout = User.IsInRole(RoleNames.Student) ? "_StudentLayout" : "_Layout"; }

<div class="password-page">
    <header class="operations-heading"><div><p class="operations-kicker">Bảo mật tài khoản</p><h1>Đổi mật khẩu</h1><p>Dùng mật khẩu riêng, không chia sẻ và không lặp lại mật khẩu tạm thời.</p></div></header>
    <section class="password-panel">
        <header><p>Xác nhận danh tính</p><h2>Tạo mật khẩu mới</h2></header>
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label><span>Mật khẩu hiện tại</span><input asp-for="CurrentPassword" autocomplete="current-password" /><small asp-validation-for="CurrentPassword"></small></label>
            <label><span>Mật khẩu mới</span><input asp-for="NewPassword" autocomplete="new-password" /><small asp-validation-for="NewPassword"></small></label>
            <label><span>Nhập lại mật khẩu mới</span><input asp-for="ConfirmPassword" autocomplete="new-password" /><small asp-validation-for="ConfirmPassword"></small></label>
            <div class="password-guidance"><strong>Mật khẩu hợp lệ</strong><span>Ít nhất 8 ký tự, gồm chữ hoa, chữ thường và số.</span></div>
            <button type="submit">Đổi mật khẩu</button>
        </form>
    </section>
</div>
