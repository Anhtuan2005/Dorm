@model ManagerDashboardViewModel
@{
    string Number(int value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
    string Money(decimal value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
    string Css(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string TimeAgo(DateTime value)
    {
        var hours = Math.Max(0, (int)(Model.GeneratedAt - value).TotalHours);
        return hours < 1 ? "Vừa xong" : hours < 24 ? $"{hours} giờ trước" : $"{hours / 24} ngày trước";
    }
    var attentionCount = Model.OverdueApplications + Model.OverdueInvoices + Model.UrgentMaintenance;
}

<div class="overview-page">
    <header class="operations-heading overview-heading">
        <div><h1>Tổng quan</h1><p>Cơ sở Thủ Đức · Cập nhật @Model.GeneratedAt.ToLocalTime().ToString("HH:mm, dd/MM/yyyy")</p></div>
        <a class="heading-room-link" asp-controller="Reports" asp-action="Index"><svg><use href="#i-chart" /></svg>Xem báo cáo</a>
    </header>
    <div class="overview-workspace">
        <div class="overview-primary">
            <section class="workspace-section attention-focus" aria-labelledby="attention-title">
                <header class="workspace-section-head"><h2 id="attention-title">Cần xử lý</h2><span data-live-overdue-total="@(attentionCount - Model.OverdueInvoices)">@attentionCount việc ưu tiên</span></header>
                <a asp-controller="Applications" asp-action="Index" asp-route-Scope="attention" asp-route-OverdueOnly="true">
                    <i><svg><use href="#i-file" /></svg></i><span><strong>Đơn lưu trú quá hạn</strong><small>@Model.NeedsInformation đơn khác đang chờ sinh viên bổ sung</small></span><b class="attention-number">@Model.OverdueApplications</b><svg><use href="#i-chevron" /></svg>
                </a>
                <a asp-controller="Billing" asp-action="Index" asp-route-Status="overdue">
                    <i><svg><use href="#i-coin" /></svg></i><span><strong>Hóa đơn quá hạn</strong><small>Mở công nợ để ghi nhận khoản thu</small></span><b class="attention-number" data-live-overdue-invoices>@Model.OverdueInvoices</b><svg><use href="#i-chevron" /></svg>
                </a>
                <a asp-controller="Maintenance" asp-action="Index" asp-route-Priority="Urgent">
                    <i><svg><use href="#i-tool" /></svg></i><span><strong>Sự cố khẩn cấp</strong><small>@Model.OpenMaintenance sự cố đang mở trong toàn KTX</small></span><b class="attention-number @(Model.UrgentMaintenance > 0 ? "danger" : "")">@Model.UrgentMaintenance</b><svg><use href="#i-chevron" /></svg>
                </a>
                <footer class="workspace-section-foot"><span>@Model.ActiveApplications đơn lưu trú đang mở</span><a asp-controller="Applications" asp-action="Index">Xem tất cả đơn <svg><use href="#i-arrow" /></svg></a></footer>
            </section>
            <section class="workspace-section building-health" aria-labelledby="building-title">
                <header class="workspace-section-head"><h2 id="building-title">Chỗ ở và sức chứa</h2><a asp-controller="Rooms" asp-action="Map">Sơ đồ phòng</a></header>
                <dl class="overview-capacity-summary">
                    <div class="assignable"><dt>Có thể xếp</dt><dd>@Number(Model.Capacity.Assignable)</dd></div>
                    <div><dt>Sức chứa</dt><dd>@Number(Model.Capacity.Capacity)</dd></div>
                    <div><dt>Đang ở</dt><dd>@Number(Model.Capacity.Occupied)</dd></div>
                    <div><dt>Đang giữ</dt><dd>@Number(Model.Capacity.Held)</dd></div>
                    <div><dt>Tạm khóa</dt><dd>@Number(Model.Capacity.Blocked)</dd></div>
                </dl>
                <div class="building-health-list">
                    @foreach (var building in Model.Buildings)
                    {
                        <a asp-controller="Rooms" asp-action="Map" asp-route-Building="@building.Code">
                            <span class="building-identity"><strong>@building.Name</strong><small>@building.Capacity.Occupied/@building.Capacity.Capacity đang ở</small></span>
                            <span class="building-bar"><i style="--value:@Css(building.Capacity.OccupancyRate)%"></i></span>
                            <span class="building-facts"><b>@building.Capacity.Assignable</b> có thể xếp<small>@building.Capacity.Blocked tạm khóa</small></span>
                            <svg><use href="#i-chevron" /></svg>
                        </a>
                    }
                </div>
            </section>
        </div>
        <aside class="overview-sidebar" aria-label="Công nợ và hoạt động gần đây">
            <section class="workspace-section money-focus">
                <header class="workspace-section-head"><h2>Công nợ</h2></header>
                <strong class="outstanding-total">@Money(Model.OutstandingBalance) đ</strong>
                <p>@Model.OutstandingInvoices hóa đơn còn phải thu</p>
                <div><span>Thu ròng tháng này</span><b>@Money(Model.CollectedThisMonth) đ</b></div>
                <a asp-controller="Billing" asp-action="Index">Mở thu phí <svg><use href="#i-arrow" /></svg></a>
            </section>
            <section class="workspace-section recent-operations">
                <header class="workspace-section-head"><h2>Cập nhật gần đây</h2></header>
                @if (Model.RecentActivities.Count == 0)
                {
                    <div class="report-empty"><strong>Chưa có hoạt động</strong></div>
                }
                else
                {
                    <div>
                        @foreach (var activity in Model.RecentActivities.Take(4))
                        {
                            <a href="@activity.TargetUrl">
                                <i><svg><use href="@(activity.Type == "billing" ? "#i-coin" : activity.Type == "maintenance" ? "#i-tool" : "#i-file")" /></svg></i>
                                <span><strong>@activity.Title</strong><p>@activity.Detail</p><small>@activity.TypeLabel · @TimeAgo(activity.OccurredAt)</small></span>
                                <svg><use href="#i-chevron" /></svg>
                            </a>
                        }
                    </div>
                }
            </section>
        </aside>
    </div>
</div>
